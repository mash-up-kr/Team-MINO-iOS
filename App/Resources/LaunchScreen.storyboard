            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView opaque="NO" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="splashWordmark" translatesAutoresizingMaskIntoConstraints="NO" id="wRd-00-003">
                                <rect key="frame" x="0.0" y="185" width="393" height="127"/>
                            </imageView>
                            <imageView opaque="NO" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="splashCharacters" translatesAutoresizingMaskIntoConstraints="NO" id="cHr-00-002">
                                <rect key="frame" x="0.0" y="474" width="393" height="377"/>
                                <constraints>
                                    <!-- 에셋 자체 비율 375:360. 폭을 화면에 맞추고 높이를 여기서 끌어낸다 -->
                                    <constraint firstAttribute="height" secondItem="cHr-00-002" secondAttribute="width" multiplier="0.96" id="cst-00-013"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
