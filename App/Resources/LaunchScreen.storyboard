                        <constraints>
                            <!-- 로고+캡션: 시안 y=176 375×121.33 → 높이 121.33/812, 세로 중심 236.67/406 -->
                            <constraint firstItem="wRd-00-003" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="cst-00-009"/>
                            <constraint firstItem="wRd-00-003" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" multiplier="0.582919" id="cst-00-010"/>
                            <constraint firstItem="wRd-00-003" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" id="cst-00-011"/>
                            <constraint firstItem="wRd-00-003" firstAttribute="height" secondItem="Ze5-6b-2t3" secondAttribute="height" multiplier="0.149421" id="cst-00-012"/>
                            <!-- 캐릭터: 시안에서 화면 밖까지 뻗는 그림을 375×812 로 잘라 구운 에셋이다(시안 y=452~812).
                                 높이가 아니라 폭에 맞춰야 좌우에 흰 여백이 생기지 않는다. 세로 중심 632/406 -->
                            <constraint firstItem="cHr-00-002" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="cst-00-005"/>
                            <constraint firstItem="cHr-00-002" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" multiplier="1.5567" id="cst-00-006"/>
                            <constraint firstItem="cHr-00-002" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" id="cst-00-007"/>
